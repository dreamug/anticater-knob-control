{
  "global": {
    "rotate_left": {
      "type": "key",
      "description": "降低音量",
      "keys": ["volume_down"]
    },
    "rotate_right": {
      "type": "key",
      "description": "提高音量",
      "keys": ["volume_up"]
    },
    "press": {
      "type": "key",
      "description": "播放 / 暂停",
      "keys": ["play_pause"]
    },
    "press_rotate_left": {
      "type": "shortcut",
      "description": "上一个媒体项目",
      "keys": ["previous_track"]
    },
    "press_rotate_right": {
      "type": "shortcut",
      "description": "下一个媒体项目",
      "keys": ["next_track"]
    }
  },
  "apps": {
    "com.apple.Terminal": {
      "rotate_left": {
        "type": "shortcut",
        "description": "上一条命令历史",
        "keys": ["up"]
      },
      "rotate_right": {
        "type": "shortcut",
        "description": "下一条命令历史",
        "keys": ["down"]
      },
      "press": {
        "type": "shortcut",
        "description": "回车",
        "keys": ["return"]
      },
      "press_rotate_left": {
        "type": "shortcut",
        "description": "移动到行首",
        "keys": ["control", "a"]
      },
      "press_rotate_right": {
        "type": "shortcut",
        "description": "移动到行尾",
        "keys": ["control", "e"]
      }
    },
    "com.google.Chrome": {
